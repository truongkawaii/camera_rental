# Copy this file to .env and fill real secrets before production deploy.

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=camera_rental

# Backend
BACKEND_PORT=5000
NODE_ENV=production
DB_SSL=false
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/camera_rental
JWT_SECRET=change_this_to_a_long_random_secret
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=camera-rental
MAX_IMAGES_PER_ENTITY=10

# Frontend build-time API endpoint
VITE_API_URL=http://localhost:5000

# User frontend
NEXT_TELEMETRY_DISABLED=1
USER_FRONTEND_API_URL=http://backend:5000
USER_FRONTEND_PORT=3000

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
